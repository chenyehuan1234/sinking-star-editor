{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sinking-star-community-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/community/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Copy this file to wrangler.local.jsonc and set the real ID for remote deployment.
  "d1_databases": [{
    "binding": "CATALOG",
    "database_name": "sinking-star-community-preview",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "DESIGNS",
    "bucket_name": "sinking-star-community-preview"
  }]
}
